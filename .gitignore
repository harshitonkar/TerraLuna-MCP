# Virtual environments
.venv/
env/
venv/
ENV/
.terraluna_venv/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.coverage
htmlcov/

# Local secrets & environment files
.env
.env.local
.env.*.local

# Dynamic runtime UI artifacts
data/artifacts/*
